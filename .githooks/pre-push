#!/bin/bash
# Parent-repo pre-push hook: run userlib pytest suite, block push on failure.
# bash (not sh): PIPESTATUS below is a bashism; under dash it is a hard error.
#
# INSTALL (one-time per checkout):
#   cp .githooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# Git refuses to share hooks via the working tree (security), so the
# source-of-truth lives at .githooks/pre-push and operators install it
# manually. Re-run the install line after a fresh clone.
#
# Logs to .git/hooks/pre-push.log; that path is inside .git/ so git
# ignores it automatically. No .gitignore entry needed.

set -e

LABSCRIPT_ENV="${LABSCRIPT_ENV:-$(git config --get rax.labscriptEnv 2>/dev/null || true)}"
LABSCRIPT_ENV="${LABSCRIPT_ENV:-labscript}"

# Derive the log dir: in a linked worktree `.git` is a FILE and the private
# gitdir (.git/worktrees/<name>/) has no hooks/ subdir — the old literal
# ".git/hooks/pre-push.log" crashed the hook there and blocked the push.
LOG_DIR="$(git rev-parse --git-dir)/hooks"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/pre-push.log"
echo "=== pre-push @ $(date) ===" >> "$LOG"

# Source conda before the userlib test suite.
# Locate conda without hardcoding a distribution name or user profile, so the
# hook works on any collaborator's fork. First hit wins: an already-exported
# CONDA_EXE, conda on PATH, then the usual install locations.
CONDA_BASE=""
if [ -n "$CONDA_EXE" ] && [ -x "$CONDA_EXE" ]; then
    CONDA_BASE="$(dirname "$(dirname "$CONDA_EXE")")"
elif command -v conda >/dev/null 2>&1; then
    CONDA_BASE="$(conda info --base 2>/dev/null)"
fi
if [ -z "$CONDA_BASE" ] || [ ! -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
    for c in "$HOME/miniconda" "$HOME/miniconda3" "$HOME/anaconda3" \
             "$HOME/Miniforge3" "/c/ProgramData/miniconda3" "/c/ProgramData/anaconda3"; do
        if [ -f "$c/etc/profile.d/conda.sh" ]; then CONDA_BASE="$c"; break; fi
    done
fi

if [ -n "$CONDA_BASE" ] && [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
    . "$CONDA_BASE/etc/profile.d/conda.sh"
    if ! conda activate "$LABSCRIPT_ENV" 2>>"$LOG"; then
        echo "pre-push: '$LABSCRIPT_ENV' conda env FAILED TO ACTIVATE — userlib tests skipped, push allowed. Fix the env; conda's error is in $LOG" | tee -a "$LOG" >&2
        exit 0
    fi
else
    echo "pre-push: no conda installation found — skipping userlib tests." | tee -a "$LOG"
    echo "         (looked at \$CONDA_EXE, conda on PATH, and the usual install locations)" | tee -a "$LOG"
    exit 0
fi

echo "Running userlib tests in env: $CONDA_DEFAULT_ENV" | tee -a "$LOG"
# Include the shared protocol tests and each device test directory.
TEST_PATHS="userlib/user_devices/*/tests/"
if [ -d "userlib/external_gui_lib/tests" ]; then
    TEST_PATHS="userlib/external_gui_lib/tests/ $TEST_PATHS"
fi
python -m pytest -q $TEST_PATHS 2>&1 | tee -a "$LOG"

RESULT=${PIPESTATUS[0]}
if [ "$RESULT" -ne 0 ]; then
    echo "pre-push: userlib tests failed (exit $RESULT). Push blocked." | tee -a "$LOG"
    echo "         See full log: $LOG" >&2
    exit "$RESULT"
fi

echo "pre-push: userlib tests passed." | tee -a "$LOG"
exit 0
